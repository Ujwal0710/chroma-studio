# AI Interior Colour Palette Suggester Configuration

# Database path (defaults to data/palettes.db)
DATABASE_PATH=data/palettes.db

# Maximum upload image size in megabytes
MAX_IMAGE_SIZE_MB=15

# Vision LLM Provider ('gemini' or 'openai_compatible')
VISION_PROVIDER=gemini
VISION_API_KEY=
VISION_MODEL=gemini-1.5-flash
VISION_API_ENDPOINT=

# AI Image Editing / Generative Preview Provider ('openai')
IMAGE_EDIT_PROVIDER=openai
IMAGE_EDIT_API_KEY=
IMAGE_EDIT_MODEL=dall-e-3
